{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-data-extraction.local/schemas/pilot/v1.0/operations/sort.schema.json",
  "title": "Pilot operation: sort",
  "description": "",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "type",
    "input_dataset",
    "output_dataset",
    "params"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "type": {
      "const": "sort"
    },
    "input_dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "output_dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "ascending",
        "nulls"
      ],
      "properties": {
        "by": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "ascending": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "boolean"
          }
        },
        "nulls": {
          "enum": [
            "FIRST",
            "LAST"
          ]
        }
      },
      "x-invariants": [
        "len(by)==len(ascending)"
      ]
    }
  },
  "x-semantics": {
    "row_count": "UNCHANGED",
    "column_count": "UNCHANGED",
    "error_policy": "FAIL",
    "errors": [
      "COLUMN_NOT_FOUND",
      "INVALID_PARAMETER"
    ],
    "algorithm": "stable"
  },
  "x-valid-examples": [
    {
      "schema_version": "1.1",
      "operation_id": "op-sort",
      "type": "sort",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "by": [
          "date"
        ],
        "ascending": [
          true
        ],
        "nulls": "LAST"
      }
    }
  ],
  "x-invalid-examples": [
    {
      "schema_version": "1.1",
      "operation_id": "op-sort",
      "type": "sort",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "by": [
          "date"
        ],
        "ascending": [],
        "nulls": "LAST"
      }
    },
    {
      "schema_version": "1.1",
      "operation_id": "op-sort",
      "type": "sort",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "by": [
          "date"
        ],
        "ascending": [
          true
        ],
        "nulls": "MIDDLE"
      }
    }
  ]
}
