    "operation_id",
    "type",
    "input_dataset",
    "output_dataset",
    "params"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "type": {
      "const": "fill_missing"
    },
    "input_dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "output_dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "strategy",
        "value"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "strategy": {
          "const": "constant"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    }
  },
  "x-semantics": {
    "row_count": "UNCHANGED",
    "column_count": "UNCHANGED",
    "error_policy": "FAIL",
    "errors": [
      "COLUMN_NOT_FOUND",
      "SCHEMA_MISMATCH",
      "INVALID_PARAMETER"
    ]
  },
  "x-valid-examples": [
    {
      "schema_version": "1.1",
      "operation_id": "op-fill_missing",
      "type": "fill_missing",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "columns": [
          "amount"
        ],
        "strategy": "constant",
        "value": 0
      }
    }
  ],
  "x-invalid-examples": [
    {
      "schema_version": "1.1",
      "operation_id": "op-fill_missing",
      "type": "fill_missing",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "columns": [
          "amount"
        ],
        "strategy": "mean",
        "value": 0
      }
    },
    {
      "schema_version": "1.1",
