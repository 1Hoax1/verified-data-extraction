{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-data-extraction.local/schemas/pilot/v1.0/operations/drop_missing.schema.json",
  "title": "Pilot operation: drop_missing",
  "description": "",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "type",
    "input_dataset",
    "output_dataset",
    "params"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "type": {
      "const": "drop_missing"
    },
    "input_dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "output_dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subset",
        "how"
      ],
      "properties": {
        "subset": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "how": {
          "enum": [
            "any",
            "all"
          ]
        }
      }
    }
  },
  "x-semantics": {
    "row_count": "DECREASES_OR_UNCHANGED",
    "column_count": "UNCHANGED",
    "error_policy": "approved deletion, audited",
    "errors": [
      "COLUMN_NOT_FOUND",
      "INVALID_PARAMETER"
    ]
  },
  "x-valid-examples": [
    {
      "schema_version": "1.1",
      "operation_id": "op-drop_missing",
      "type": "drop_missing",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "subset": [
          "name"
        ],
        "how": "any"
      }
    }
  ],
  "x-invalid-examples": [
    {
      "schema_version": "1.1",
      "operation_id": "op-drop_missing",
      "type": "drop_missing",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "subset": [],
        "how": "any"
      }
    },
    {
      "schema_version": "1.1",
      "operation_id": "op-drop_missing",
      "type": "drop_missing",
      "input_dataset": "raw",
      "output_dataset": "result",
      "params": {
        "subset": [
          "name"
        ],
        "how": "some"
      }
    }
  ]
}
