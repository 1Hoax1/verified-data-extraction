{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-data-extraction.local/schemas/pilot/v1.0/qa_report.schema.json",
  "title": "Pilot QAReport",
  "description": "",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "run_id",
    "brief_version_id",
    "transformation_spec_version_id",
    "generated_at",
    "overall_status",
    "dataset_summary",
    "deterministic_checks",
    "llm_review",
    "blocking_issues",
    "warnings",
    "sampling_manifest",
    "known_limitations",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "report_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "brief_version_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "transformation_spec_version_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_status": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL"
      ]
    },
    "dataset_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "row_count",
        "column_count",
        "columns",
        "output_headers",
        "file_size_bytes",
        "checksum"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "column_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_headers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\x00-\\x1F\\x7F-\\x9F]{1,128}$",
            "description": "Actual CSV/XLSX header. Stored value is trimmed and Unicode NFC; C0/C1 controls, tab and line breaks are forbidden.",
            "x-normalization": "trim_then_unicode_nfc",
            "x-default-from": "name"
          },
          "description": "Actual exported CSV/XLSX headers in artifact order."
        }
      }
    },
    "deterministic_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "https://verified-data-extraction.local/schemas/pilot/v1.0/qa_check_result.schema.json"
      }
    },
    "llm_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "NOT_APPLICABLE"
        },
        "reason": {
          "const": "PILOT_SLICE_V1_NO_LLM"
        }
      }
    },
    "blocking_issues": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sampling_manifest": {
      "type": "null"
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_type",
          "path",
          "checksum"
        ],
        "properties": {
          "artifact_type": {
            "enum": [
              "RESULT_CSV",
              "RESULT_XLSX",
              "QA_REPORT",
              "EXECUTION_LOG"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "x-invariants": [
    "dataset_summary.columns contains internal technical names.",
    "dataset_summary.output_headers contains actual exported headers and is unique after trim and Unicode NFC."
  ]
}
