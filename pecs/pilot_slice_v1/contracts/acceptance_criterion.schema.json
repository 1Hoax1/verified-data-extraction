{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-data-extraction.local/schemas/pilot/v1.0/acceptance_criterion.schema.json",
  "title": "Pilot AcceptanceCriterion",
  "description": "",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "criterion_id",
    "name",
    "description",
    "category",
    "check_mode",
    "severity",
    "target",
    "operator",
    "expected",
    "tolerance",
    "source",
    "requirement_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "criterion_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "category": {
      "enum": [
        "schema",
        "completeness",
        "uniqueness",
        "format",
        "range",
        "volume",
        "output"
      ]
    },
    "check_mode": {
      "const": "DETERMINISTIC"
    },
    "severity": {
      "enum": [
        "BLOCKER",
        "ERROR",
        "WARNING",
        "INFO"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "dataset_id",
        "column",
        "columns",
        "artifact_type",
        "metric"
      ],
      "properties": {
        "scope": {
          "enum": [
            "DATASET",
            "COLUMN",
            "COLUMNS",
            "ARTIFACT",
            "METRIC"
          ]
        },
        "dataset_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "column": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "columns": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "artifact_type": {
          "enum": [
            null,
            "INPUT",
            "RESULT_CSV",
            "RESULT_XLSX",
            "QA_REPORT"
          ]
        },
        "metric": {
          "enum": [
            null,
            "row_count",
            "column_count",
            "null_count",
            "null_ratio",
            "duplicate_count",
            "unique_count",
            "parse_error_count",
            "input_checksum",
            "output_checksum"
          ]
        }
      }
    },
    "operator": {
      "enum": [
        "exists",
        "absent",
        "readable",
        "checksum_equals",
        "type_equals",
        "set_equals",
        "set_contains",
        "sequence_equals",
        "equals",
        "not_equals",
        "in_set",
        "not_in_set",
        "between_inclusive",
        "min_value",
        "max_value",
        "exact_count",
        "min_count",
        "max_count",
        "min_ratio",
        "max_ratio",
        "all_non_null",
        "unique",
        "matches_format"
      ]
    },
    "expected": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": [
                "number",
                "string"
              ]
            },
            "max": {
              "type": [
                "number",
                "string"
              ]
            }
          }
        }
      ]
    },
    "tolerance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "source": {
      "enum": [
        "listing",
        "attachment",
        "client_answer",
        "user_assumption"
      ]
    },
    "requirement_status": {
      "enum": [
        "CONFIRMED",
        "ASSUMED",
        "NOT_APPLICABLE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "exists",
              "absent",
              "readable",
              "all_non_null",
              "unique"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "min_ratio",
              "max_ratio"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "exact_count",
              "min_count",
              "max_count"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "checksum_equals"
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "type_equals"
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "enum": [
              "string",
              "integer",
              "decimal",
              "boolean",
              "date",
              "datetime",
              "url"
            ]
          }
        }
      }
    }
  ]
}
